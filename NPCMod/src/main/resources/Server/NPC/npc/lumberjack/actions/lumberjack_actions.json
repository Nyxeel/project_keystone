{
  "id": "lumberjack_actions",
  "version": 1,

  "actions": {
    "chop_wood": {
      "animation": "lumberjack.chop",
      "loop": true,
      "sound": "npc.axe.hit_wood",
      "soundIntervalSeconds": 1.8,
      "requiresCapability": "USE_TOOLS"
    },

    "open_chest": {
      "animation": "human.open_chest",
      "loop": false,
      "sound": "block.chest.open",
      "requiresCapability": "USE_CHEST"
    },

    "eat_meal": {
      "animation": "human.eat",
      "loop": true,
      "sound": "npc.human.eat",
      "soundIntervalSeconds": 2.2,
      "requiresCapability": null
    },

    "relax": {
      "animation": "human.relax",
      "loop": true,
      "sound": null,
      "requiresCapability": null
    },

    "sleep": {
      "animation": "human.sleep",
      "loop": true,
      "sound": null,
      "requiresCapability": "USE_BED"
    }
  },

  "markerActions": {
    "WORK": {
      "type": "work_area_loop",
      "primaryAction": "chop_wood",

      "workArea": {
        "centerMarker": "work",
        "radius": 12.0,
        "maxTargets": 5,
        "targetType": "tree"
      },

      "targetSearch": {
        "mode": "marker_first",
        "markerRole": "TREE",
        "fallbackToBlockSearch": false
      },

      "navigationOverride": {
        "pathStyle": "practical",
        "stayInsideRadius": true,
        "returnToMarkerWhenDone": true
      },

      "steps": [
        {
          "type": "find_target",
          "target": "tree"
        },
        {
          "type": "move_to_target",
          "stopDistance": 1.5
        },
        {
          "type": "look_at_target"
        },
        {
          "type": "play_action",
          "action": "chop_wood",
          "durationSeconds": 4.0
        },
        {
          "type": "repeat_until_routine_changes"
        }
      ],

      "fallback": {
        "whenNoTargetFound": "return_to_work_marker",
        "idleAction": "relax"
      }
    },

    "CHEST": {
      "type": "single_action",
      "action": "open_chest",
      "durationSeconds": 2.0
    },

    "FOOD": {
      "type": "timed_action",
      "action": "eat_meal",
      "durationSeconds": 10.0
    },

    "CHILL": {
      "type": "idle_action",
      "action": "relax"
    },

    "BED": {
      "type": "idle_action",
      "action": "sleep"
    }
  },

  "debug": {
    "logActionStart": true,
    "logTargetSearch": true,
    "logStepChanges": false
  }
}